{
  "name": "coding-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx",
    "portal": "concurrently -k -n api,ui -c blue,green \"npm run portal:api\" \"npm run portal:ui\"",
    "portal:api": "PORTAL_API_ONLY=1 tsx portal/server.ts",
    "portal:ui": "vite --config portal/vite.config.ts",
    "portal:build": "vite build --config portal/vite.config.ts",
    "test:run": "tsx --test",
    "test:findMedianSortedArrays": "npm run test:run -- findMedianSortedArrays/findMedianSortedArrays.test.ts",
    "test:bisection": "npm run test:run -- bisection/binarySearch.test.ts",
    "test:search-rotated": "npm run test:run -- search-rotated/searchRotated.test.ts",
    "test:search-bitonic": "npm run test:run -- search-bitonic/searchBitonic.test.ts",
    "test:sorted-matrix-search": "npm run test:run -- sorted-matrix-search/searchSortedMatrix.test.ts",
    "test:kth": "npm run test:run -- kth/findKthSortedArrays.test.ts",
    "test:heapsort": "npm run test:run -- heapsort/heapSort.test.ts",
    "test:partition": "npm run test:run -- partition/partition.test.ts",
    "test:quicksort": "npm run test:run -- quicksort/quickSort.test.ts",
    "test:reverse-pairs": "npm run test:run -- reverse-pairs/reversePairs.test.ts",
    "test:course-schedule": "npm run test:run -- course-schedule-ii/findOrder.test.ts",
    "test:edit-distance": "npm run test:run -- edit-distance/minDistance.test.ts",
    "test:common-subsequence": "npm run test:run -- common-subsequence/commonSubseqLen.test.ts",
    "test:climbing-stairs": "npm run test:run -- climbing-stairs/climbStairs.test.ts",
    "test:histogram": "npm run test:run -- largest-rectangle/largestRectangleArea.test.ts",
    "test:daily-temperatures": "npm run test:run -- daily-temperatures/dailyTemperatures.test.ts",
    "test:maximal-rectangle": "npm run test:run -- maximal-rectangle/maximalRectangle.test.ts",
    "test:min-window": "npm run test:run -- min-window-substring/minWindow.test.ts",
    "test:max-path-sum": "npm run test:run -- max-path-sum/maxPathSum.test.ts",
    "test:tree-paths": "npm run test:run -- tree-paths/treePaths.test.ts",
    "test:kth-smallest-bst": "npm run test:run -- kth-smallest-bst/kthSmallest.test.ts",
    "test:level-order": "npm run test:run -- level-order/levelOrder.test.ts",
    "test:lru": "npm run test:run -- lru-cache/LRUCache.test.ts",
    "test:my-calendar": "npm run test:run -- my-calendar/MyCalendar.test.ts",
    "test:count-smaller": "npm run test:run -- count-smaller/countSmaller.test.ts",
    "test:avl-tree": "npm run test:run -- avl-tree/AVLTree.test.ts",
    "test:number-islands": "npm run test:run -- number-of-islands/numIslands.test.ts",
    "test:spreading-fire": "npm run test:run -- spreading-fire/timeToBurn.test.ts",
    "test:combinations": "npm run test:run -- combinations/combine.test.ts",
    "test:subsets": "npm run test:run -- subsets/subsets.test.ts",
    "test:permutations": "npm run test:run -- permutations/permute.test.ts",
    "test:generate-parentheses": "npm run test:run -- generate-parentheses/generateParenthesis.test.ts",
    "test:combination-sum": "npm run test:run -- combination-sum/combinationSum.test.ts",
    "test:combination-sum-count": "npm run test:run -- combination-sum-count/combinationSumCount.test.ts",
    "test:coin-change": "npm run test:run -- coin-change/coinChange.test.ts",
    "test:ordered-sum-count": "npm run test:run -- ordered-sum-count/orderedSumCount.test.ts",
    "test:lowest-common-ancestor": "npm run test:run -- lowest-common-ancestor/lowestCommonAncestor.test.ts",
    "test:linked-list-cycle": "npm run test:run -- linked-list-cycle/linkedListCycle.test.ts",
    "test:reverse-linked-list": "npm run test:run -- reverse-linked-list/reverseList.test.ts",
    "test:merge-intervals": "npm run test:run -- merge-intervals/mergeIntervals.test.ts",
    "test:clone-graph": "npm run test:run -- clone-graph/cloneGraph.test.ts",
    "test:number-provinces": "npm run test:run -- number-of-provinces/findProvinces.test.ts",
    "test:shortest-path": "npm run test:run -- shortest-path/shortestPath.test.ts",
    "test:kth-largest": "npm run test:run -- kth-largest/findKthLargest.test.ts",
    "test:knapsack": "npm run test:run -- knapsack/knapsack.test.ts",
    "test:tsp": "npm run test:run -- traveling-salesman/tsp.test.ts",
    "test:knight-probability": "npm run test:run -- knight-probability/knightProbability.test.ts",
    "test:champagne-tower": "npm run test:run -- champagne-tower/champagneTower.test.ts",
    "test:new-21-game": "npm run test:run -- new-21-game/new21Game.test.ts",
    "test:tree-iterator": "npm run test:run -- tree-iterator/treeIterator.test.ts",
    "test:circular-queue": "npm run test:run -- circular-queue/Queue.test.ts",
    "test:day1": "npm run test:run -- course-schedule-ii/findOrder.test.ts edit-distance/minDistance.test.ts largest-rectangle/largestRectangleArea.test.ts",
    "test:day2": "npm run test:run -- min-window-substring/minWindow.test.ts max-path-sum/maxPathSum.test.ts lru-cache/LRUCache.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "marked": "^18.0.7",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
