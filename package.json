    "test:knapsack": "npm run test:run -- knapsack/knapsack.test.ts",
    "test:traveling-salesman": "npm run test:run -- traveling-salesman/travelingSalesman.test.ts",
    "test:knight-survival-probability": "npm run test:run -- knight-survival-probability/knightSurvivalProbability.test.ts",
    "test:overflow-pyramid": "npm run test:run -- overflow-pyramid/overflowPyramid.test.ts",
    "test:stop-at-k-draw-game": "npm run test:run -- stop-at-k-draw-game/stopAtKDrawGame.test.ts",
