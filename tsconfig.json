{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "portal/**/*.ts",
    "test/**/*.ts",
    "findMedianSortedArrays/**/*.ts",
    "bisection/**/*.ts",
    "kth/**/*.ts",
    "heapsort/**/*.ts",
    "course-schedule-ii/**/*.ts",
    "edit-distance/**/*.ts",
    "climbing-stairs/**/*.ts",
    "largest-rectangle/**/*.ts",
    "min-window-substring/**/*.ts",
    "max-path-sum/**/*.ts",
    "lru-cache/**/*.ts"
  ]
}
